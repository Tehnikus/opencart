{% if filter_sets %}
  <div class="panel panel-default">
    <div class="panel-heading">
      {{ heading_title }}
    </div>
    <div>
      <select id="sortOrder">
        {% for sortOrder in sortOrders %}
          <option value="{{ sortOrder.value }}">{{ sortOrder.name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="facetFilter"> 
      {% for filter_set_name, filter_set in filter_sets %}
        {% for key, filter_group in filter_set %}
          <h4>{{filter_group.group_name}}</h4>
          {% for filter_val in filter_group.filters %}
            <a href="{{ filter_val.href }}">
              <input type="checkbox" data-filter-type="{{ filter_set_name }}" value="{{ filter_val.filter_id }}" {% if filter_val.filter_id in requests[filter_set_name] %} checked="checked" {% endif %} />
              <span class="facetName">{{ filter_val.name }}</span>
              <span class="productCount">({{ filter_val.product_count }})</span>
            </a>
          {% endfor %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
{% endif %}
<script>

document.getElementById('sortOrder').addEventListener('change', (e) => {
  setParams('sort', e.target.value);
});

function setParams(param, value = null) {

  const url = new URL(window.location.href);

  if (value) {
    url.searchParams.set(param, value);
  } else {
    url.searchParams.delete(param);
  }

  window.location.href = url.toString();

  // For future reference when filter will get products by JS fetch
  // history.replaceState(null, '', url);
}

</script>
