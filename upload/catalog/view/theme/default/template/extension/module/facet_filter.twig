{% if filter_sets %}
  <div class="panel panel-default">
    <div class="panel-heading">
      {{ heading_title }}
    </div>
    <div>
      <select id="sortOrder">
        {% for sortOrder in sortOrders %}
          <option value="{{ sortOrder.value }}" {% if requestSort == sortOrder.value %}selected{% endif %}>{{ sortOrder.name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="facetFilter">
      <a class="btn btn-primary" href="{{ resetLink }}">{{ button_reset_filters }}</a>
        {% for key, facetGroup in filter_set %}
          <h4>{{facetGroup.group_name}}</h4>
          <div class="facetGroup">
            {% for facetItem in facetGroup.filters %}
              {% if facetItem.current_count %}
                <a href="{{ facetItem.href }}" class="facetItem {% if facetItem.facet_is_selected %}active{% endif %}">
                  <input type="checkbox" data-facet-type="{{ facetType }}" value="{{ facetItem.facet_id }}" {% if facetItem.facet_id in requests[facetType] %} checked="checked" {% endif %} class="facetInput" />
                  <span class="facetName">{{ facetItem.facet_name }}</span>
                  <span class="productCount">{% if facetGroup.group_is_selected and not facetItem.facet_is_selected %}+{% endif %}{{ facetItem.current_count }}</span>
                </a>
              {% else %}
              <span class="facetItem">
                <input type="checkbox" class="facetInput" disabled />
                <span class="facetName disabled">{{ facetItem.facet_name }}</span>
              </span>
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
{% endif %}
<script>

document.getElementById('sortOrder').addEventListener('change', (e) => {
  setParams('sort', e.target.value);
});

function setParams(param, value = null) {

  const url = new URL(window.location.href);

  if (value) {
    url.searchParams.set(param, value);
  } else {
    url.searchParams.delete(param);
  }

  window.location.href = url.toString();

  // For future reference when filter will get products by JS fetch
  // history.replaceState(null, '', url);
}

</script>
